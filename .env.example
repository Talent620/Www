# ---------------------------------------------------------------------------
# Aurea environment configuration
# Copy to .env and fill in. The platform RUNS WITHOUT any AI keys using the
# built-in deterministic generation engine; keys unlock the live AI models.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://aurea:aurea@localhost:5432/aurea?schema=public"

# --- AI engine -------------------------------------------------------------
# Which provider the AI engine should use: "auto" (default), "anthropic", or
# "deterministic". "auto" uses Anthropic when ANTHROPIC_API_KEY is present and
# falls back to the deterministic engine otherwise.
AI_PROVIDER="auto"

# Anthropic API key. Leave blank to force the deterministic engine.
ANTHROPIC_API_KEY=""

# Default model for the primary planning/authoring model role.
AI_MODEL_PRIMARY="claude-opus-4-8"
# Faster model used for high-volume, lower-stakes generation (per-section copy).
AI_MODEL_FAST="claude-haiku-4-5"

# --- App -------------------------------------------------------------------
# Public base URL, used in generated metadata / sitemaps.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used to sign sessions / tokens (replace in production).
AUTH_SECRET="change-me-in-production"

# --- Payments (optional) ---------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

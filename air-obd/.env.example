# Shared
RELAY_TOKEN=change-me-to-a-long-random-secret
SESSION=leon-123          # any unique id; master and slave must match

# --- relay (run on a VPS with a public IP / domain) ---
RELAY_PORT=8080
RELAY_HOST=0.0.0.0
HEARTBEAT_MS=15000

# --- master (diagnostic PC) ---
RELAY_URL=wss://relay.example.com     # ws:// for local testing, wss:// in production
MASTER_HOST=127.0.0.1
MASTER_PORT=35000                     # point VCDS/OBD app at this host:port

# --- slave (in the car) ---
# RELAY_URL is shared with master (above)
# Choose ONE adapter transport:
#   WiFi ELM327:
ADAPTER_HOST=192.168.0.10
ADAPTER_PORT=35000
#   OR serial/USB adapter (needs the optional 'serialport' dependency):
# SERIAL_PATH=/dev/ttyUSB0
# SERIAL_BAUD=38400

RECONNECT_MS=3000
